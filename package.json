{
  "name": "dsh-kb-lite",
  "version": "0.4.3",
  "description": "Local knowledge base for DeepSeek Harness: five host-only tools to ingest Markdown, plain text and PDF, retrieve passages with BM25 or hybrid BM25 plus optional local embeddings, and return cited file/line sources. Offline by default; Node.js 18+ and Python 3.9+ are required, and PDF ingest needs pymupdf.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "engine/kb_engine.py",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0-0 || >=0.2.0-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "dsh",
    "rag",
    "knowledge-base",
    "bm25",
    "local",
    "retrieval"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaused/dsh-kb-lite.git"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
