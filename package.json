{
  "name": "dsh-kb-lite",
  "version": "0.4.13",
  "description": "Local knowledge base for DeepSeek Harness: six host-only tools (ingest, search, ask, stats, sync, clear) to index Markdown, plain text and PDF files, retrieve cited passages with BM25 or hybrid BM25 plus optional local embeddings, report index freshness against the memory roots, and sync only changed files. Offline by default; Node.js 18+ and Python 3.9+ are required, and PDF ingest needs pymupdf.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "engine/kb_engine.py",
    "scripts/kb-sync-audit.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "dsh",
    "rag",
    "knowledge-base",
    "bm25",
    "local",
    "retrieval"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imaused/dsh-kb-lite.git"
  },
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
